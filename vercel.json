{
  "version": 2,
  "builds": [
    {
      "src": "src/app.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/app.ts"
    }
  ],
  "crons": [
    {
      "schedule": "0 6 * * *",
      "path": "/api/internal/locations/refresh"
    }
  ]
}
